NEXT_PUBLIC_WHATSAPP_NUMBER=549XXXXXXXXXX
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/berenice_lenceria/
NEXT_PUBLIC_SITE_URL=https://berenice.com.ar
# Invitación al grupo de WhatsApp: alimenta el QR y el botón "Sumarme al grupo". Vacía = se ocultan
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/XXXXXXXXXXXXXXXXXXXXXX
# noindex/nofollow salvo el valor exacto "true" (contenido provisorio: dejar en false)
NEXT_PUBLIC_ALLOW_INDEXING=false
# Fuente del catálogo: mock | supabase. Se lee desde V2.2; producción queda en mock hasta V2.9
CATALOG_SOURCE=mock
# Supabase (V2). URL base del proyecto (sin /rest/v1) y clave PÚBLICA (publishable sb_publishable_… o anon).
# Nunca la service role / secret key: no se usa en el runtime ni en V2.1.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
